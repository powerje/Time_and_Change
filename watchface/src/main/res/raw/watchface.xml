        <!-- Block O - large, centered -->
        <PartImage x="140" y="330" width="170" height="224">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Image resource="block_o"/>
        </PartImage>

        <!-- Block O - Ambient mode -->
        <PartImage x="140" y="330" width="170" height="224" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255"/>
            <Image resource="block_o_ambient"/>
        </PartImage>
    </Scene>
