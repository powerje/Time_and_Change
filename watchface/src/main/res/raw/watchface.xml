                <PartText x="0" y="208" width="450" height="60">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Text align="CENTER">
                        <Font family="roboto_light" size="68" weight="NORMAL" slant="NORMAL" color="#ffb2b2b2">STILL</Font>
                    </Text>
                </PartText>
                <PartText x="0" y="265" width="450" height="60">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Text align="CENTER">
                        <Font family="roboto_light" size="56" weight="NORMAL" slant="NORMAL" color="#ffb2b2b2">SUCKS</Font>
                    </Text>
