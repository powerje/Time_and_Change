        </ListConfiguration>

        <!-- Ambient text (always white on black) -->
        <PartText x="0" y="82" width="450" height="95" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255"/>
            <Text align="CENTER">
                <Font family="roboto_light" size="88" weight="NORMAL" slant="NORMAL" color="#ffefefef">AND</Font>
            </Text>
        </PartText>
        <PartText x="0" y="172" width="450" height="40" alpha="0">
