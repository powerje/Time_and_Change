                    </Text>
                </PartText>
            </ListOption>
            <ListOption id="bg_white">
                <PartText x="0" y="82" width="450" height="95">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Text align="CENTER">
                        <Font family="roboto_light" size="88" weight="NORMAL" slant="NORMAL" color="#ff333333">AND</Font>
                    </Text>
                </PartText>
                <PartText x="0" y="172" width="450" height="40">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Text align="CENTER">
